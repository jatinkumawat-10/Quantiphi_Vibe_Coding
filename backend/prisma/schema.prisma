generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("users")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceName          String             @map("service_name")
  cost                 Decimal            @db.Decimal(10, 2)
  billingCycle         BillingCycle       @map("billing_cycle")
  nextRenewalDate      DateTime           @map("next_renewal_date") @db.Date
  status               SubscriptionStatus @default(ACTIVE)
  // Feature 2: Notes
  notes                String?            @db.Text
  // Feature 3: Cost-splitting
  isShared             Boolean            @default(false) @map("is_shared")
  splitCount           Int                @default(1) @map("split_count")
  splitNote            String?            @map("split_note")
  // Feature 4: Free trial tracker
  isTrial              Boolean            @default(false) @map("is_trial")
  trialEndDate         DateTime?          @map("trial_end_date") @db.Date
  trialReminderDays    Int                @default(3) @map("trial_reminder_days")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, status])
  @@index([userId, nextRenewalDate])
  @@map("subscriptions")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
}
